# ReactWeb - variables de entorno (Vite)
#
# Copia este fichero a `.env` (ignorado por git) o define las variables en tu
# plataforma de despliegue. Ningun valor real se versiona.
#
# Recuerda: todo lo que empieza por VITE_ se incrusta en el bundle y por tanto
# es publico. No pongas aqui nunca claves de servidor (service_role, secretos
# de Stripe, tokens de API privados...).

# ── API backend ───────────────────────────────────────────────
VITE_API_URL=

# ── Supabase (solo clave anon/publishable) ────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Google OAuth ──────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=

# ── Mapbox (tokens publicos, restringelos por dominio) ────────
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_PUBLIC_TOKEN=

# ── Flags de desarrollo (opcionales) ──────────────────────────
VITE_DEBUG_ROUTES=
VITE_HP_CARD_LAYOUT=
