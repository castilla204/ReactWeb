<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push notifications (APNs). "development" sirve para pruebas en dispositivo con
	  build de debug; para App Store / TestFlight Xcode usa "production" automáticamente
	  con el perfil de aprovisionamiento correcto. Este fichero debe quedar referenciado
	  en Build Settings > CODE_SIGN_ENTITLEMENTS del target App (Xcode lo hace solo al
	  añadir la capability "Push Notifications" en Signing & Capabilities).
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
